PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/qrinvite
JWT_SECRET=supersecret_jwt_key_qrinvite_change_in_production
ED25519_MASTER_SECRET=ed25519_master_envelope_key_32_bytes_long_secret
REDIS_URL=redis://127.0.0.1:6379

# Meta WhatsApp Cloud API
WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token

# Payment Gateways (Paystack & Flutterwave)
PAYSTACK_SECRET_KEY=sk_live_or_test_key
PAYSTACK_PUBLIC_KEY=pk_live_or_test_key
FLUTTERWAVE_SECRET_HASH=your_flutterwave_secret_hash

APP_URL=http://localhost:5173
